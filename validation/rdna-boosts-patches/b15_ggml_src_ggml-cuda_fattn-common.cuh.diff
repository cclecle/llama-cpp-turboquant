+    for (int l = 0; l < GGML_CUDA_FA_Q8_CHUNK/2; ++l) {
+        const uint8_t b0 = qs[base + 2*l + 0];
+        const uint8_t b1 = qs[base + 2*l + 1];
+        const float f0 = (float) ((lo ? (b0 & 0x0F) : (b0 >> 4)) | (((qh >> (off + 2*l + 0)) & 1) << 4));
